[Unit]
Description=Solana Validator
After=network.target
StartLimitIntervalSec=0

[Service]
User={{ sdo_user }}
LogRateLimitIntervalSec=0
Type=simple
Restart=always
RestartSec=1
{% if validator_type == 'Paladin' %}
Environment=PATH=/home/{{ sdo_user }}/paladin/target/release
{% else %}
Environment=PATH=/home/{{ sdo_user }}/jito/scripts/bin
{% endif %}
WorkingDirectory=/home/{{ sdo_user }}
{% if group_names[0] == 'testnet' %}
Environment=SOLANA_METRICS_CONFIG=host=https://metrics.solana.com:8086,db=tds,u=testnet_write,p=c4fa841aa918bf8274e3e2a44d77568d9861b3ea
{% else %}
Environment=SOLANA_METRICS_CONFIG=host=https://metrics.solana.com:8086,db=mainnet-beta,u=mainnet-beta_write,p=password
{% endif %}
ExecStart=/home/{{ sdo_user }}/validator-startup.sh

[Install]
WantedBy=multi-user.target